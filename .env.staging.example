# Staging verification environment template.
# Copy to a private location outside git, fill values, then source it before running staging scripts.

# Public Node gateway URL, without trailing slash.
API_BASE_URL=https://staging.example.com

# Optional direct Rust URL used only for proxy-guard smoke checks.
# Leave empty if direct Rust is internal-only and not reachable from the runner.
API_V2_DIRECT_URL=

# Node -> Rust upstream URL. Used by deploy/runtime, not by browser clients.
API_V2_UPSTREAM_URL=http://127.0.0.1:9010
API_V2_PROXY_SECRET=replace-with-staging-proxy-secret
# Generate independently (for example: openssl rand -base64 48); never reuse JWT_SECRET.
SESSION_TOKEN_HASH_SECRET=replace-with-independent-32-plus-character-secret
SESSION_REFRESH_ENABLED=false
SESSION_REFRESH_MEMBER_COHORT_PERCENT=0
SESSION_REFRESH_CS_COHORT_PERCENT=0
SESSION_REFRESH_ADMIN_COHORT_PERCENT=0
SESSION_REFRESH_OWNER_COHORT_PERCENT=0
LEGACY_ACCESS_TOKEN_ACCEPT_UNTIL=2026-08-15T00:00:00Z

# Global API v1 kill switch. Enable after API v2 smoke/readiness confirms no legacy clients remain.
API_V1_DISABLED=false

# Legacy API v1 rewards/points gates. Prefer disabling writes after API v2 smoke passes.
LEGACY_REWARDS_POINTS_WRITES_DISABLED=true
LEGACY_REWARDS_POINTS_READS_DISABLED=false

# Database used by optional mutation smoke and transaction dry-run evidence checks.
MONGO_URI=mongodb://user:password@staging-mongodb.example.com:27017/POBB
MONGO_DB=POBB
# Keep true in staging/production; requires replica set or sharded cluster support.
MONGO_TRANSACTIONS_ENABLED=true
SMOKE_MONGO_URI=mongodb://user:password@staging-mongodb.example.com:27017/POBB
SMOKE_MONGO_DB=POBB

# Admin/team account for smoke checks. Must have the permissions documented in the runbook.
SMOKE_EMAIL=admin-staging@example.com
SMOKE_PASSWORD=replace-with-staging-password

# Disposable member for provider readiness and transaction dry-run.
SMOKE_MEMBER_EMAIL=member-staging@example.com
SMOKE_MEMBER_PASSWORD=replace-with-member-password

# Provider smoke mode. Prefer sandbox for staging verification unless explicitly approved otherwise.
PROVIDER_MODE=sandbox
RUN_PROVIDER_SMOKE=1
CONFIRM_PROVIDER_BACKEND_SANDBOX=1
CONFIRM_GAME_VALIDATION_SANDBOX=1
PROVIDER_SANDBOX_DIGIFLAZZ_BASE_URL=https://provider-sandbox.example.com
PROVIDER_SANDBOX_TOKOVOUCHER_BASE_URL=https://provider-sandbox.example.com
GAME_VALIDATION_CODASHOP_BASE_URL=https://provider-sandbox.example.com
GAME_VALIDATION_GOPAY_BASE_URL=https://provider-sandbox.example.com

# Mutation smoke is opt-in because it creates and cleans test data.
RUN_API_V2_MUTATION_SMOKE=1

# Transaction create dry run. Fill only after target/product/account approval.
RUN_TRANSACTION_CREATE_DRY_RUN=1
CONFIRM_TRANSACTION_CREATE_DRY_RUN_BALANCE_CHANGE=1
DRY_RUN_MEMBER_EMAIL=member-staging@example.com
DRY_RUN_MEMBER_PASSWORD=replace-with-member-password
DRY_RUN_ADMIN_EMAIL=admin-staging@example.com
DRY_RUN_ADMIN_PASSWORD=replace-with-staging-password
DRY_RUN_PRODUCT_CODE=APPROVED_LOW_VALUE_PRODUCT_CODE
DRY_RUN_TARGET=APPROVED_TEST_TARGET
DRY_RUN_SERVER_ID=
DRY_RUN_OUTPUT_PATH=/tmp/webtopup-staging-transaction-create-dry-run.json
# Rust session rotation/recovery key rings (base64url no-pad; exactly 32 decoded bytes per key).
SESSION_ROTATION_ACTIVE_KEY_ID=rotation-v1
SESSION_ROTATION_KEYS=rotation-v1:replace-with-base64url-no-pad-32-byte-key
SESSION_RECOVERY_ENCRYPTION_ACTIVE_KEY_ID=recovery-aead-v1
SESSION_RECOVERY_ENCRYPTION_KEYS=recovery-aead-v1:replace-with-base64url-no-pad-32-byte-key
# Bounded abandoned legacy-migration cleanup worker.
LEGACY_MIGRATION_CLEANUP_INTERVAL_SECONDS=60
LEGACY_MIGRATION_CLEANUP_BATCH_SIZE=100
