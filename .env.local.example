# DEVELOPMENT/LOCAL ONLY — never use this file for production or staging.
# Copy to ignored local env files on a developer machine only.
# Local service URLs
API_BASE_URL=http://localhost:9005
API_V2_DIRECT_URL=http://127.0.0.1:9010
API_V2_UPSTREAM_URL=http://127.0.0.1:9010

# Local service ports
PORT=9005
RUST_API_PORT=9010
VITE_PORT=9006
PROVIDER_SANDBOX_PORT=9020

# Local security values; replace for your machine and never commit real secrets.
JWT_SECRET=replace-with-local-jwt-secret
# Generate independently (for example: openssl rand -base64 48); never reuse JWT_SECRET.
SESSION_TOKEN_HASH_SECRET=replace-with-independent-32-plus-character-secret
API_V2_PROXY_SECRET=replace-with-local-api-v2-proxy-secret
SESSION_REFRESH_ENABLED=false
SESSION_REFRESH_MEMBER_COHORT_PERCENT=0
SESSION_REFRESH_CS_COHORT_PERCENT=0
SESSION_REFRESH_ADMIN_COHORT_PERCENT=0
SESSION_REFRESH_OWNER_COHORT_PERCENT=0
LEGACY_ACCESS_TOKEN_ACCEPT_UNTIL=2026-08-15T00:00:00Z

# Global API v1 kill switch. Keep false locally unless testing API v1 removal.
API_V1_DISABLED=false

# Legacy API v1 rewards/points gates. Keep reads off until all legacy clients are removed.
LEGACY_REWARDS_POINTS_WRITES_DISABLED=false
LEGACY_REWARDS_POINTS_READS_DISABLED=false

# MongoDB fixture database for local smoke verification.
MONGO_URI=mongodb://user:pass@localhost:27017/POBB
MONGO_DB=POBB
# Set false only if your local MongoDB is standalone and cannot run transactions.
MONGO_TRANSACTIONS_ENABLED=true
SMOKE_MONGO_URI=mongodb://user:pass@localhost:27017/POBB
SMOKE_MONGO_DB=POBB

# Smoke credentials. Keep these pointed at disposable local fixtures.
SMOKE_EMAIL=tester29@gmail.com
SMOKE_PASSWORD=Tester2909!@
SMOKE_MEMBER_EMAIL=api-v2-member-smoke@example.com
SMOKE_MEMBER_PASSWORD=ApiV2MemberSmoke2909!

# Development-only provider sandbox defaults. Never set in production/staging.
# Do not point these at live providers unless a runbook explicitly approves it.
PROVIDER_MODE=sandbox
PROVIDER_SANDBOX_DIGIFLAZZ_BASE_URL=http://127.0.0.1:9020
PROVIDER_SANDBOX_TOKOVOUCHER_BASE_URL=http://127.0.0.1:9020
GAME_VALIDATION_CODASHOP_BASE_URL=http://127.0.0.1:9020
GAME_VALIDATION_GOPAY_BASE_URL=http://127.0.0.1:9020
# Rust session rotation/recovery key rings (base64url no-pad; exactly 32 decoded bytes per key).
SESSION_ROTATION_ACTIVE_KEY_ID=rotation-v1
SESSION_ROTATION_KEYS=rotation-v1:replace-with-base64url-no-pad-32-byte-key
SESSION_RECOVERY_ENCRYPTION_ACTIVE_KEY_ID=recovery-aead-v1
SESSION_RECOVERY_ENCRYPTION_KEYS=recovery-aead-v1:replace-with-base64url-no-pad-32-byte-key
# Bounded abandoned legacy-migration cleanup worker.
LEGACY_MIGRATION_CLEANUP_INTERVAL_SECONDS=60
LEGACY_MIGRATION_CLEANUP_BATCH_SIZE=100
