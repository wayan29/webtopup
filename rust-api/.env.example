API_V2_HOST=127.0.0.1
API_V2_PORT=9010
API_V2_ALLOWED_ORIGIN=http://localhost:9006
API_V2_PROXY_SECRET=replace-with-32-plus-random-characters
JWT_SECRET=replace-with-the-same-32-plus-character-secret-used-by-node
# Generate independently (for example: openssl rand -base64 48); never reuse JWT_SECRET.
SESSION_TOKEN_HASH_SECRET=replace-with-independent-32-plus-character-secret
# Session refresh rollout flags (must match Node gateway semantics; invalid values fail closed).
SESSION_REFRESH_ENABLED=false
SESSION_REFRESH_MEMBER_COHORT_PERCENT=0
SESSION_REFRESH_CS_COHORT_PERCENT=0
SESSION_REFRESH_ADMIN_COHORT_PERCENT=0
SESSION_REFRESH_OWNER_COHORT_PERCENT=0
LEGACY_ACCESS_TOKEN_ACCEPT_UNTIL=2026-08-15T00:00:00Z
MONGO_URI=mongodb://localhost:27017/POBB
MONGO_DB=POBB
# Set false only for local standalone MongoDB that cannot run transactions.
# Production/staging financial mutations should keep this true and use a replica set/sharded cluster.
MONGO_TRANSACTIONS_ENABLED=true
# Shared upload storage used by Node static serving and Rust API v2.
# Use an absolute path in production.
UPLOAD_DIR=../uploads
RUST_LOG=webtopup_rust_api=debug,tower_http=info,axum=info
OTEL_ENABLED=true
OTEL_SERVICE_NAME=webtopup-rust-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_ENVIRONMENT=development
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
TOKOVOUCHER_MEMBER_CODE=
TOKOVOUCHER_SECRET=
# Dedicated session rotation derivation/digest key ring. Values are base64url without padding, exactly 32 decoded bytes.
SESSION_ROTATION_ACTIVE_KEY_ID=rotation-v1
SESSION_ROTATION_KEYS=rotation-v1:replace-with-base64url-no-pad-32-byte-key
# Separate AEAD key ring; retain retired keys through every referenced recovery window.
SESSION_RECOVERY_ENCRYPTION_ACTIVE_KEY_ID=recovery-aead-v1
SESSION_RECOVERY_ENCRYPTION_KEYS=recovery-aead-v1:replace-with-base64url-no-pad-32-byte-key
# Bounded abandoned legacy-migration cleanup worker.
LEGACY_MIGRATION_CLEANUP_INTERVAL_SECONDS=60
LEGACY_MIGRATION_CLEANUP_BATCH_SIZE=100
# Development sandbox only; never set implicitly in production/staging.
# GAME_VALIDATION_CODASHOP_BASE_URL=http://127.0.0.1:9020
# GAME_VALIDATION_GOPAY_BASE_URL=http://127.0.0.1:9020
# Cloudflare Turnstile (read by this service; secret is never stored in Mongo).
# TURNSTILE_SECRET_KEY=
# TURNSTILE_DISABLED=
