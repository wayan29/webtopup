# Server Configuration
# HOST defaults to 0.0.0.0 for existing deployments. Local verification sets 127.0.0.1.
HOST=0.0.0.0
PORT=9005
NODE_ENV=development
# Explicit marker used only by the guarded local verification stack.
LOCAL_DEV_VERIFICATION=false

# Auth refresh always uses fixed limits: 300 requests/IP/15m and
# 30 requests/credential/15m, each with a 15m block. Browser headers and environment
# profiles cannot select or loosen these buckets. Other auth routes retain their policy.

# Exact public browser origin trusted for credentialed CORS and auth mutations.
# Include scheme and port when non-default; do not use a wildcard.
PUBLIC_APP_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/POBB

# JWT Secret (generate a strong secret key)
JWT_SECRET=your-jwt-secret-key-here

# API v2 upstream service
API_V2_UPSTREAM_URL=http://127.0.0.1:9010
# Optional shared secret sent only from Node proxy to API v2.
# Set the same value in API v2 runtime to reject direct sensitive requests.
API_V2_PROXY_SECRET=replace-with-32-plus-random-characters

# Refresh-session rollout and bounded legacy bearer compatibility.
# Invalid percentages/cutoff values fail closed (throw at read time).
SESSION_REFRESH_ENABLED=false
SESSION_REFRESH_MEMBER_COHORT_PERCENT=0
SESSION_REFRESH_CS_COHORT_PERCENT=0
SESSION_REFRESH_ADMIN_COHORT_PERCENT=0
SESSION_REFRESH_OWNER_COHORT_PERCENT=0
LEGACY_ACCESS_TOKEN_ACCEPT_UNTIL=2026-08-15T00:00:00Z

# Global API v1 kill switch. Set true only after clients/smoke checks are fully on /api/v2.
API_V1_DISABLED=false

# Legacy API v1 rewards/points gates.
# Writes can be disabled once clients use /api/v2. Reads are a later, more breaking switch.
LEGACY_REWARDS_POINTS_WRITES_DISABLED=false
LEGACY_REWARDS_POINTS_READS_DISABLED=false

# Shared upload storage used by Node static serving and Rust API v2.
# Use an absolute path in production.
UPLOAD_DIR=../uploads

# OpenTelemetry tracing (Jaeger all-in-one / OTLP HTTP)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=webtopup-node-gateway
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_ENVIRONMENT=development
# Optional debug output: debug, info, warn, error, none
OTEL_LOG_LEVEL=warn

# Scheduler token for Digiflazz Seller callback retry queue
# Use this token with header: X-Scheduler-Token: your-secret-token
DIGIFLAZZ_SELLER_RETRY_QUEUE_TOKEN=your-scheduler-token-here

# Digiflazz Configuration (optional)
DIGIFLAZZ_USERNAME=your-digiflazz-username
DIGIFLAZZ_API_KEY=your-digiflazz-api-key

# Tokovoucher Configuration (optional)
TOKOVOUCHER_USERNAME=your-tokovoucher-username
TOKOVOUCHER_API_KEY=your-tokovoucher-api-key

# Provider execution mode for safe provider-backed smoke tests
# live = current behavior, mock = deterministic in-process adapter with no network calls,
# sandbox = explicit HTTP stub/base URL, never default
PROVIDER_MODE=live
PROVIDER_MOCK_TOPUP_STATUS=pending
PROVIDER_MOCK_RECHECK_STATUS=pending
PROVIDER_MOCK_MESSAGE=
PROVIDER_MOCK_SN=
PROVIDER_MOCK_BALANCE=0
PROVIDER_MOCK_VENDOR_TRX_ID=
PROVIDER_SANDBOX_DIGIFLAZZ_BASE_URL=http://127.0.0.1:9020
PROVIDER_SANDBOX_TOKOVOUCHER_BASE_URL=http://127.0.0.1:9020
