{
  "name": "pobb-server",
  "version": "1.0.0",
  "description": "PPOB Backend Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed:admin": "ts-node src/scripts/create-admin.ts",
    "catalog:clone": "ts-node src/scripts/clone-catalog.ts",
    "catalog:audit": "ts-node src/scripts/audit-catalog.ts",
    "catalog:remediate": "ts-node src/scripts/remediate-catalog.ts",
    "indexes:rewards-points": "ts-node src/scripts/ensure-reward-point-indexes.ts",
    "test:security": "cd ../rust-api && cargo test --bin webtopup-rust-api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^13.4.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "mongoose": "^8.24.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "protobufjs@7.6.1": true
  }
}
